<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hobby.HobbyEditor">
    <ContentPage.Content>
        <StackLayout>
            <StackLayout x:Name="Editor">
                <StackLayout Orientation="Horizontal" >
                    <Label Text="Название"></Label>
                    <Entry x:Name="NameEntry" HorizontalOptions="Fill" WidthRequest="250"></Entry>
                </StackLayout>
                <StackLayout Orientation="Horizontal">
                    <Label Text="Продолжительность работы"></Label>
                    <Entry x:Name="WorkDurationEntry" HorizontalOptions="Fill" WidthRequest="250"></Entry>
                </StackLayout>
                <StackLayout Orientation="Horizontal">
                    <Label Text="Продолжительность отдыха"></Label>
                    <Entry x:Name="RestDurationEntry" HorizontalOptions="Fill" WidthRequest="250"></Entry>
                </StackLayout>
                <Button x:Name="Confirm" Text="Подтвердить" Clicked="Confirm_Clicked"></Button>
                <Button x:Name="Cancle" Text="Отмена" Clicked="Cancle_Clicked"></Button>
            </StackLayout>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>