<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hobby.TimerPage">
    <ContentPage.Content>
        <StackLayout>

            <StackLayout x:Name="CurrentTimer" VerticalOptions="Center" HorizontalOptions="Center">
                <Label x:Name="TimerLabel" Text="25:00" FontSize="40" HorizontalOptions="Center" />
                <StackLayout x:Name="AdditionalButtons" Orientation="Horizontal" HorizontalOptions="Center">
                    <Button x:Name="StartButton" Text="Старт" BackgroundColor="Orange" Clicked="StartButton_Clicked" />
                    <Button x:Name="ResetButton" Text="Сброс" Clicked="ResetButton_Clicked" />
                </StackLayout>
            </StackLayout>

            <CollectionView x:Name="TaskItemsCollection" ItemsSource ="{Binding Tasks}" HeightRequest="500">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackLayout Grid.Column="0">
                                <Label Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold" />
                                <Label Text="{Binding WorkDuration}" FontSize="Small" TextColor="Gray" />
                                <Label Text="{Binding RestDuration}" FontSize="Small" TextColor="Gray" />
                            </StackLayout>

                            <Button Grid.Column="1" 
                                    Text="▶" 
                                    Command="{Binding StartCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="Green"
                                    FontSize="Medium"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="20"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="Add" Text="+" Clicked="Add_Clicked" 
                    HorizontalOptions="Center" 
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BackgroundColor="LightBlue"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>