<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hobby.TimerPage"
             >
    
    <ContentPage.Content>
        <StackLayout>

            <StackLayout x:Name="CurrentTimer" 
                         Margin="0,120,0,0"
                         VerticalOptions="Center" 
                         >
                <Label x:Name="TimerLabel" 
                       Text="00:00" 
                       FontSize="60" 
                       TextColor="Black"
                       HorizontalOptions="Center" />
                
                <StackLayout x:Name="AdditionalButtons" Orientation="Horizontal" HorizontalOptions="Center">
                    <Button x:Name="StartButton" Text="Старт" BackgroundColor="Orange" Clicked="StartButton_Clicked" />
                    <Button x:Name="ResetButton" Text="Сброс" Clicked="ResetButton_Clicked" />
                </StackLayout>
                <Rectangle BackgroundColor="Black" 
                           Margin="0,20,0,0"
                           HeightRequest="2"></Rectangle>
            </StackLayout>

            <CollectionView x:Name="TaskItemsCollection" 
                            ItemsSource="{Binding Tasks}"
                            HeightRequest="300"
                            SelectionMode="Single"
                            SelectionChanged="TaskItemsCollection_SelectionChanged"
                            >
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10,10,10,10" BackgroundColor="Transparent">
                            <Frame BorderColor="Black" CornerRadius="30" >
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" 
                                        Text="▶" 
                                    
                                        Command="{Binding StartCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="Black"
                                        FontSize="Medium"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        CornerRadius="20"
                                        BorderColor="Black"
                                        BorderWidth="3"
                                
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center"/>

                                    <StackLayout Grid.Column="1" 
                                             HorizontalOptions="Start"
                                             VerticalOptions="Center"
                                             Orientation="Horizontal">
                                            
                                        <Label Text="{Binding Name}" FontSize="Medium" FontAttributes="Bold" />
                                        
                                        <Label Text="{Binding DisplayWorkDuration}" FontSize="Small" TextColor="Gray" />
                                        <Label Text="{Binding DisplayRestDuration}" FontSize="Small" TextColor="Gray" />
                                            
                                    </StackLayout>
                                </Grid>
                            </Frame>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button x:Name="Add" Text="+" Clicked="Add_Clicked" 
                    FontSize="30"
                    HorizontalOptions="Center" 
                    WidthRequest="50"
                    HeightRequest="50"
                    CornerRadius="25"
                    BorderColor="Black"
                    BorderWidth="3"
                    BackgroundColor="Transparent"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>