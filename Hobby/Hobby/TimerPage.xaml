<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:tool="http://xamarin.com/schemas/2020/toolkit"

             x:Class="Hobby.TimerPage"
            xmlns:local="clr-namespace:Hobby;assembly=Hobby"

>

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0">
                <!-- Выбор режима таймера -->
                <Grid WidthRequest="200" 
                  HorizontalOptions="Start" 
                  Margin="20,30,0,0" 
                  RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Frame x:Name="PickerBackground"
                        BackgroundColor="#B55757"
                           IsVisible="False"
                       CornerRadius="10"
                       Grid.RowSpan="2"
                       Grid.ColumnSpan="2"
                       ></Frame>
                    <Button x:Name="SelectedMode"
                        Clicked="SelectedMode_Clicked"
                        Text="Pomodoro"
                        TextColor="White"
                        TextTransform="None"
                        FontSize="25"
                        FontFamily="VisionRegular"
                        BackgroundColor="Transparent"
                        Grid.Row="0"/>
                    <Button x:Name="UnSelectedMode" 
                        Clicked="UnSelectedMode_Clicked"
                        IsVisible="False"
                        Text="Free Timer"
                        TextColor="White"
                        TextTransform="None"
                        FontFamily="VisionRegular"
                        FontSize="25"
                        BackgroundColor="Transparent"
                        Grid.Row="1"/>
                    <Image  x:Name="ModePickerArrow"
                        Source= "{local:ImageResource Hobby.Images.arrowDown.png}"  
                        Grid.Column="1" 
                        Grid.Row="0"
                        Margin="10,0,10,0"
                       />
                </Grid>

                <!-- Контейнер Pomodoro -->
                <StackLayout x:Name="PomodoroContainer" Padding="50, 0, 50, 82" >
                    <Label x:Name="PomodoroTimerLabel" 
                           Text="00:00" 
                           FontFamily="VisionBold"
                           FontSize="80" 
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Grid>
                        <Image  Grid.Column="0"
                            x:Name="PomodoroResetButtonImage"
                            Source = "{local:ImageResource Hobby.Images.rotateccw.png}" 
                            HeightRequest="40"
                            WidthRequest="40"/>

                        <Image  Grid.Column="1"
                            x:Name="PomodoroStartButtonImage"
                            Source = "{local:ImageResource Hobby.Images.play.png}"
                            HeightRequest="40"
                            WidthRequest="40" 
                            />
                        <Button x:Name="PomodoroResetButton"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            Clicked="PomodoroResetButton_Clicked"
                            HeightRequest="40"
                            WidthRequest="40"/>
                        <Button x:Name="PomodoroStartButton"
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            Clicked="PomodoroStartButton_Clicked"
                            HeightRequest="40"
                            WidthRequest="40"/>
                        <Button BackgroundColor="Transparent" IsEnabled="False" Grid.Column="2"/>
                    </Grid>
                </StackLayout>

                <!-- Контейнер FreeTimer -->
                <StackLayout x:Name="FreeTimerContainer" IsVisible="False" Padding="50, 0, 50, 25">
                    <Label x:Name="FreeTimerLabel" 
                       Text="00:00" 
                       FontSize="80" 
                       FontFamily="VisionBold"
                       TextColor="White"
                       HorizontalOptions="Center"/>

                    <Grid>
                        <Image  Grid.Column="0"
                        x:Name="FreeResetButtonImage"
                        Source = "{local:ImageResource Hobby.Images.rotateccw.png}"
                        HeightRequest="40"
                        WidthRequest="40"/>

                        <Image  Grid.Column="1"
                        x:Name="FreeStartButtonImage"
                        Source = "{local:ImageResource Hobby.Images.play.png}"
                        HeightRequest="40"
                        WidthRequest="40" />
                        <Image  Grid.Column="2"
                        x:Name="ResetTotalButtonImage"
                        Source = "{local:ImageResource Hobby.Images.refreshccw.png}"
                        HeightRequest="40"
                        WidthRequest="40" />

                        <Button x:Name="FreeResetButton" 
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            Clicked="FreeResetButton_Clicked"/>
                        <Button x:Name="FreeStartButton" 
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            Clicked="FreeStartButton_Clicked"/>
                        <Button x:Name="ResetTotalButton" 
                            Grid.Column="2"
                            BackgroundColor="Transparent" 
                            Clicked="ResetTotalButton_Clicked"/>
                    </Grid>

                    <Label x:Name="TotalTimeLabel" 
                           Text="{Binding CurrentTaskItem.TotalWorkTime, StringFormat='{0:hh\\:mm\\:ss}'}"
                           FontFamily="VisionBold"
                           FontSize="30" 
                           Margin="0,10,0,0"
                           TextColor="#FFC0C0"
                           HorizontalOptions="Center"
                           />
                </StackLayout>

                <!-- Общий список задач -->
                <CollectionView x:Name="TaskItemsCollection" 
                           ItemsSource="{Binding Tasks}"
                           HeightRequest="300"
                           SelectionMode="Single"
                           
                           SelectionChanged="TaskItemsCollection_SelectionChanged">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="20,5,20,5" BackgroundColor="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <!-- Состояние нормальное -->
                                        <VisualState Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <!-- Состояние выделения -->
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Pink"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Frame CornerRadius="15">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackLayout Grid.Column="0" 
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center"
                                       Orientation="Horizontal">
                                            <Label Text="{Binding Name}" FontSize="25" FontFamily="VisionRegular" TextColor="Black" VerticalOptions="Center"/>
                                            <Label Text="{Binding DisplayWorkDuration}" FontSize="20" FontFamily="VisionRegular" TextColor="Gray"  Margin="10,0,0,0" VerticalOptions="Center"/>
                                            <Label Text="{Binding DisplayRestDuration}" FontSize="20" FontFamily="VisionRegular" TextColor="Gray" VerticalOptions="Center"/>
                                        </StackLayout>
                                        <Image Grid.Column="1"
                                            Source = "{local:ImageResource Hobby.Images.trash.png}"/>
                                        <Button Grid.Column="1" 
                                        FontSize= "Medium"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        BackgroundColor="Transparent"
                                        Command="{Binding DeleteCommand}"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Кнопка добавления -->
                <Grid Margin="10">
                    <Image 
                        Source="{local:ImageResource Hobby.Images.pluscircle.png}"
                        WidthRequest="40"
                        HeightRequest="40"
                        Aspect="AspectFit"/>
                    <Button x:Name="AddButton" 
                        Clicked="OnShowMenuClicked"               
                        HorizontalOptions="Center" 
                        WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="Transparent"
                        />
                </Grid>

            </StackLayout>

            <!-- Затемненный фон (скрыт по умолчанию) -->
            <BoxView x:Name="Overlay"
             BackgroundColor="#80000000"
             Opacity="0"
             IsVisible="False"
             Grid.RowSpan="1"/>

            <!-- Контейнер меню (изначально за экраном) -->
            <Grid x:Name="BottomMenu"
                Grid.Row="0"
                Padding="0"
                VerticalOptions="End"
                TranslationY="500">

                <!-- Все это ради уголка слева сверху :) -->
                <Frame Grid.Row="0" CornerRadius="50" BackgroundColor="White"/>
                <Frame Grid.Row="0" BackgroundColor="White" VerticalOptions="End"/>
                <Frame Grid.Row="0" BackgroundColor="White" HorizontalOptions="End"/>

                <StackLayout Spacing="0" Grid.Row="0">
                    <!-- Заголовок меню -->
                    <StackLayout Margin="30">
                        <Label Text="Добавить занятие"   
                            TextColor="Black"
                            FontFamily="VisionBold"
                            FontSize="35"
                            HorizontalTextAlignment="Start"
                            HorizontalOptions="Start"/>
                        <!-- Тут крестик можно добавить ес нужно
                            <Image Source= "{local:ImageResource Hobby.Images.pluscircle.png}"
                            HeightRequest="20"
                            HorizontalOptions="End"
                            VerticalOptions="Start">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseMenuTapped"/>
                            </Image.GestureRecognizers>
                        </Image> -->
                    </StackLayout>

                    <!-- Элементы меню -->
                    <Frame BackgroundColor="#D9D9D9" 
                           Margin="30,0,30,10" 
                           CornerRadius="30">
                        <Entry x:Name="NameEntry" 
                               Placeholder="Введите новое занятие" 
                               FontFamily="VisualRegular" 
                               FontSize="25"/>
                    </Frame>
                    <Grid Margin= "30,0,30,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="80"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="Время работы:" 
                               VerticalOptions="Center" 
                               FontFamily="VisualRegular" FontSize="25"/>
                        <Entry Grid.Row="0" Grid.Column="1" x:Name="WorkDurationEntryMinutes"
                               Text ="25" FontFamily="VisualRegular" FontSize="25"/>
                        <Label Grid.Row="0" Grid.Column="2" Text=":" VerticalOptions="Center" 
                               FontFamily="VisualRegular" FontSize="25"/>
                        <Entry Grid.Row="0" Grid.Column="3" x:Name="WorkDurationEntrySeconds"
                               Text ="00" FontFamily="VisualRegular" FontSize="25"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Время отдыха:" VerticalOptions="Center"
                               FontFamily="VisualRegular" FontSize="25"/>
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="RestDurationEntryMinutes"
                               Text ="25" FontFamily="VisualRegular" FontSize="25"/>
                        <Label Grid.Row="1" Grid.Column="2" Text=":" VerticalOptions="Center" 
                               FontFamily="VisualRegular" FontSize="25"/>
                        <Entry Grid.Row="1" Grid.Column="3" x:Name="RestDurationEntrySeconds"
                               Text ="00" FontFamily="VisualRegular" FontSize="25"/>
                        <ImageButton Grid.Row="2" Grid.Column="3" 
                                     HorizontalOptions="End"
                                     WidthRequest="60"
                                     HeightRequest="60"
                                     BackgroundColor="Transparent"
                                     Source = "{local:ImageResource Hobby.Images.confirm.png}"
                                     Clicked="ConfirmNew_Clicked"/>
                    </Grid>
                </StackLayout>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>