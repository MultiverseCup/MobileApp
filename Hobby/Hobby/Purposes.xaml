<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Hobby"
    x:Class="Hobby.PurposesPage"
    Title="Планировщик задач">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:BoolToTextDecorationConverter x:Key="BoolToTextDecorationConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <StackLayout Padding="20">

                <Label Text="План на сегодня"
                       FontSize="24"
                       FontAttributes="Bold"
                       Margin="0,0,0,10"/>

                <CollectionView
                    x:Name="ScheduleCollection"
                    ItemsSource="{Binding ScheduleItems}"
                    SelectionMode="None"
                    Margin="0,0,0,20">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame CornerRadius="10" Padding="10" Margin="0,0,0,10" BackgroundColor="#F5F5F5">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:PurposesPage}}, Path=BindingContext.ItemTappedCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <StackLayout>

                                    <!-- Название задачи -->
                                    <Label Text="{Binding TaskName}"
                                           FontSize="16"
                                           TextColor="Black"
                                           TextDecorations="{Binding IsOverdue, Converter={StaticResource BoolToTextDecorationConverter}}" />

                                    <!-- Дата дедлайна -->
                                    <Label Text="{Binding Deadline, StringFormat='Дедлайн: {0:dd.MM.yyyy}'}"
                                           FontSize="14"
                                           TextColor="Gray"/>

                                    <!-- Прогресс -->
                                    <Label Text="{Binding ElapsedHours, StringFormat='Прошло: {0:F1} ч'}"
                                           FontSize="14"
                                           TextColor="Gray"/>
                                    <Label Text="{Binding PlannedHours, StringFormat='План: {0:F1} ч'}"
                                           FontSize="14"
                                           TextColor="Gray"/>

                                    <!-- Статус -->
                                    <Label Text="{Binding StatusText}"
                                           TextColor="{Binding StatusColor}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           IsVisible="{Binding HasStatus}" />

                                </StackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Кнопка открытия меню -->
                <Grid HorizontalOptions="Center">
                    <Image Source="{local:ImageResource Hobby.Images.pluscircle.png}" WidthRequest="50" HeightRequest="50"/>
                    <Button BackgroundColor="Transparent" WidthRequest="50" HeightRequest="50" Clicked="OnShowMenuClicked"/>
                </Grid>

            </StackLayout>

            <!-- Затемнение -->
            <BoxView x:Name="Overlay" BackgroundColor="#80000000" Opacity="0" IsVisible="False"/>

            <!-- Меню снизу -->
            <Grid x:Name="BottomMenu" VerticalOptions="End" TranslationY="600">
                <Frame BackgroundColor="White" CornerRadius="20" Margin="10" HeightRequest="400">
                    <ScrollView>
                        <StackLayout Padding="20" Spacing="15">
                            <Label Text="Добавить план" FontSize="22" FontAttributes="Bold"/>

                            <Label Text="Занятие" FontSize="18"/>
                            <Picker x:Name="TaskPicker" Title="Выберите занятие"/>

                            <Label Text="Требуемое время (часы)" FontSize="18"/>
                            <Entry x:Name="PlannedTimeEntry" Keyboard="Numeric" Placeholder="1.5" FontSize="16"/>

                            <Label Text="Крайний срок" FontSize="18"/>
                            <DatePicker x:Name="DeadlineChooser" MinimumDate="{x:Static sys:DateTime.Today}" Format="D"/>

                            <Button Text="Добавить" BackgroundColor="#B55757" TextColor="White" CornerRadius="10" FontSize="18" Clicked="OnConfirmAddSchedule"/>
                            <Button Text="Отмена" BackgroundColor="Gray" TextColor="White" CornerRadius="10" FontSize="18" Clicked="OnCloseMenuTapped"/>
                        </StackLayout>
                    </ScrollView>
                </Frame>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
