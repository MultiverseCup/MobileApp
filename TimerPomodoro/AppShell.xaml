<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TimerPomodoro.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TimerPomodoro"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
     >

    <TabBar>
        <ShellContent Title="Расписание" 
              
              ContentTemplate="{DataTemplate local:ShedulePage}"/>
        <ShellContent Title="Таймер" 
                      
                      ContentTemplate="{DataTemplate local:TimerPage}"/>
        <ShellContent Title="Планировщик" 
                      
                      ContentTemplate="{DataTemplate local:PurposesPage}" />
    </TabBar>
</Shell>
