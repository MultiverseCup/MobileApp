<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PomodoroProject.Views.SchedulePage"
            
             xmlns:viewmodel="clr-namespace:PomodoroProject.ViewModels"
            xmlns:model="clr-namespace:PomodoroProject.Data.Models"
            x:DataType="viewmodel:ScheduleViewModel">
    <VerticalStackLayout>
        <Border
            BackgroundColor="#FF7E7E"
            StrokeShape="RoundRectangle 0,0,50,50"
            StrokeThickness="0"
            HeightRequest="100">
                <Label Text="Расписание" 
                   FontFamily="VisionBold"
                   FontSize="25"
                   TextColor="White"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"/>
        </Border>

        <Label 
            Text="Выберите рабочие дни:"
            FontFamily="VisionBold"
            FontSize="25"
            Margin="20"
            HorizontalOptions="Center"
             />

        <StackLayout 
            Margin="10"
            Spacing="10"
            WidthRequest="300"
            >
            <Button Text="ПН" BackgroundColor="Gray" />
            <Button Text="ВТ" BackgroundColor="Gray" />
            <Button Text="СР" BackgroundColor="Gray" />
            <Button Text="ЧТ" BackgroundColor="Gray" />
            <Button Text="ПТ" BackgroundColor="Gray" />
            <Button Text="СБ" BackgroundColor="Gray" />
            <Button Text="ВС" BackgroundColor="Gray" />
        </StackLayout>

        
        
        
        <!--Тестовые кнопки-->
        <Button Text="Start SPAM"
            Command="{Binding TestNotificationCommand}"
                BackgroundColor="{Binding CLR}"/>

        <Button Text="Stop"
            Command="{Binding StopTestNotificationCommand}"
            BackgroundColor="{Binding CLR}"/>
    </VerticalStackLayout>
</ContentPage>