<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PomodoroProject.Views.TimerPage"
    BackgroundImageSource="bg.jpg"
    Title="Timer">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackLayout Grid.Row="0">

            <!-- Выбор режима таймера (фиксированный размер) -->
            <Grid
                WidthRequest="200"
                HeightRequest="90"
                HorizontalOptions="Start"
                Margin="20,30,0,0"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="45" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    BackgroundColor="#B55757"
                    IsVisible="False"
                    StrokeShape="RoundRectangle 10"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    WidthRequest="200"
                    HeightRequest="90" />

                <Button
                    Text="Pomodoro"
                    TextColor="White"
                    TextTransform="None"
                    FontSize="25"
                    FontFamily="VisionRegular"
                    BackgroundColor="Transparent"
                    Grid.Row="0"
                    WidthRequest="140"
                    HeightRequest="45" />

                <Button
                    IsVisible="False"
                    Text="Free Timer"
                    TextColor="White"
                    TextTransform="None"
                    FontFamily="VisionRegular"
                    FontSize="25"
                    BackgroundColor="Transparent"
                    Grid.Row="1"
                    WidthRequest="140"
                    HeightRequest="45" />

                <Image
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="10,0,10,0"
                    WidthRequest="45"
                    HeightRequest="45"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Контейнер Pomodoro -->
            <StackLayout  Padding="50,0,50,82">
                <Label
                    
                    Text="00:00"
                    FontFamily="VisionBold"
                    FontSize="80"
                    TextColor="White"
                    HorizontalOptions="Center" />
                <Grid>
                    <Image
                        Grid.Column="0"
                        
                        HeightRequest="40"
                        WidthRequest="40" />
                    <Image
                        Grid.Column="1"
                        
                        HeightRequest="40"
                        WidthRequest="40" />
                    <Button
                        
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                        
                        HeightRequest="40"
                        WidthRequest="40" />
                    <Button
                        
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        
                        HeightRequest="40"
                        WidthRequest="40" />
                    <Button
                        BackgroundColor="Transparent"
                        IsEnabled="False"
                        Grid.Column="2" />
                </Grid>
            </StackLayout>

            <!-- Контейнер FreeTimer -->
            <StackLayout
                
                IsVisible="False"
                Padding="50,0,50,25">
                <Label
                    x:Name="FreeTimerLabel"
                    Text="00:00"
                    FontSize="80"
                    FontFamily="VisionBold"
                    TextColor="White"
                    HorizontalOptions="Center" />
                <Grid>
                    <Image
                        Grid.Column="0"
                        
                        HeightRequest="40"
                        WidthRequest="40" />
                    <Image
                        Grid.Column="1"
                        
                        HeightRequest="40"
                        WidthRequest="40" />
                    <Image
                        Grid.Column="2"
                        
                        HeightRequest="40"
                        WidthRequest="40" />
                    <Button
                        
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                         />
                    <Button
                        x:Name="FreeStartButton"
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        />
                    <Button
                        x:Name="ResetTotalButton"
                        Grid.Column="2"
                        BackgroundColor="Transparent"
                        
                        VerticalOptions="Center" />
                </Grid>
                <Label
                    FontFamily="VisionBold"
                    FontSize="30"
                    Margin="0,10,0,0"
                    TextColor="#FFC0C0"
                    HorizontalOptions="Center" />
            </StackLayout>

            <!-- Общий список задач -->
            <CollectionView>

            </CollectionView>


            <!-- Кнопка добавления -->
            <Grid Margin="10">
                <Image
                    WidthRequest="40"
                    HeightRequest="40"
                    Aspect="AspectFit" />
                <Button
                    
                    HorizontalOptions="Center"
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="Transparent" />
            </Grid>

        </StackLayout>

        <!-- Затемненный фон (скрыт по умолчанию) -->
        <BoxView
            x:Name="Overlay"
            BackgroundColor="#80000000"
            Opacity="0"
            IsVisible="False"
            Grid.RowSpan="1" />

        <!-- Контейнер меню (изначально за экраном) -->
        <Grid
            x:Name="BottomMenu"
            Grid.Row="0"
            Padding="0"
            VerticalOptions="End"
            TranslationY="500">
            <Border Grid.Row="0" StrokeShape="RoundRectangle 50" BackgroundColor="White" />
            <Border Grid.Row="0" BackgroundColor="White" VerticalOptions="End" />
            <Border Grid.Row="0" BackgroundColor="White" HorizontalOptions="End" />

            <StackLayout Spacing="0" Grid.Row="0">
                <!-- Заголовок меню -->
                <StackLayout Margin="30">
                    <Label
                        Text="Добавить занятие"
                        TextColor="Black"
                        FontFamily="VisionBold"
                        FontSize="35"
                        HorizontalTextAlignment="Start"
                        HorizontalOptions="Start" />
                </StackLayout>

                <!-- Элементы меню -->
                <Border
                    BackgroundColor="#D9D9D9"
                    Margin="30,0,30,10"
                    StrokeShape="RoundRectangle 30">
                    <Entry
                        x:Name="NameEntry"
                        Placeholder="Введите новое занятие"
                        FontFamily="VisualRegular"
                        FontSize="25" />
                </Border>
                
                <Grid Margin="30,0,30,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="80" />
                    </Grid.RowDefinitions>

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Время работы:"
                        VerticalOptions="Center"
                        FontFamily="VisualRegular"
                        FontSize="25" />
                    <Entry
                        Grid.Row="0"
                        Grid.Column="1"
                        
                        Text="25"
                        FontFamily="VisualRegular"
                        FontSize="25" />
                    <Label
                        Grid.Row="0"
                        Grid.Column="2"
                        Text=":"
                        VerticalOptions="Center"
                        FontFamily="VisualRegular"
                        FontSize="25" />
                    <Entry
                        Grid.Row="0"
                        Grid.Column="3"
                        
                        Text="00"
                        FontFamily="VisualRegular"
                        FontSize="25" />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Время отдыха:"
                        VerticalOptions="Center"
                        FontFamily="VisualRegular"
                        FontSize="25" />
                    <Entry
                        Grid.Row="1"
                        Grid.Column="1"
                       
                        Text="25"
                        FontFamily="VisualRegular"
                        FontSize="25" />
                    <Label
                        Grid.Row="1"
                        Grid.Column="2"
                        Text=":"
                        VerticalOptions="Center"
                        FontFamily="VisualRegular"
                        FontSize="25" />
                    <Entry
                        Grid.Row="1"
                        Grid.Column="3"
                       
                        Text="00"
                        FontFamily="VisualRegular"
                        FontSize="25" />
                    <ImageButton
                        Grid.Row="2"
                        Grid.Column="3"
                        HorizontalOptions="End"
                        WidthRequest="60"
                        HeightRequest="60"
                        BackgroundColor="Transparent"
                         />
                </Grid>
            </StackLayout>
        </Grid>
    </Grid>

</ContentPage>