<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:conv="clr-namespace:PomodoroProject.Converters"
            xmlns:sys="clr-namespace:System;assembly=mscorlib"
            x:Class="PomodoroProject.Views.PurposesPage"
            BackgroundColor="#E5E5E5"
            xmlns:viewmodel="clr-namespace:PomodoroProject.ViewModels"
            xmlns:model="clr-namespace:PomodoroProject.Data.Models"
            x:DataType="viewmodel:PurposesViewModel"
            >

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolToInverse x:Key="Inverse"/>
            <conv:BoolToGreenColor x:Key="BoolToGreen"/>
            <conv:BoolToStrike x:Key="BoolToStrike"/>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <AbsoluteLayout>
        <StackLayout
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All">

            <Border
                BackgroundColor="{DynamicResource GlobalColor}"
                StrokeShape="RoundRectangle 0,0,50,50"
                StrokeThickness="0"
                HeightRequest="100">
                <Label 
                        Text="Планировщик задач" 
                       FontFamily="VisionBold"
                       FontSize="25"
                       TextColor="White"
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>

            </Border>
            <RefreshView Command="{Binding CheckDeadlinesCommand}"
                         IsRefreshing="{Binding IsDeadlinesRefreshing}"
                         Margin="20">
                <CollectionView 
                    SelectionMode="None"
                    ItemsSource="{Binding Deadlines}"
                    MaximumHeightRequest="800"
                    ItemSizingStrategy="MeasureAllItems"
                
                >
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:TaskDeadline">
                        <StackLayout >
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding DisplayDeadline}" VerticalOptions="Center"/>
                                <Label Text="·" FontSize="28"/>
                                <Label Text="{Binding DisplayPlannedTime}" VerticalOptions="Center"/>
                                <Label Text=" ч." VerticalOptions="Center"/>
                            </StackLayout>
                            <Border BackgroundColor="White" Padding="7" StrokeShape="RoundRectangle 25" StrokeThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Label Grid.ColumnSpan="3" Grid.Row="0" Text="{Binding DeadlineName}" 
                                           FontSize="16" 
                                           TextColor="{Binding IsCompleted,Converter={StaticResource BoolToGreen}}"
                                           TextDecorations="{Binding IsOverdue, Converter={StaticResource BoolToStrike}}"/>
                                    <Label Grid.Column="0" Grid.Row="1" Text="Прогресс:"/>
                                    <Label Grid.Column="0" Grid.Row="2" Text="{Binding DisplayElapsedTotalTime}"/>
                                    <Label Grid.Column="1" Grid.Row="1" Text="Занятие:" />
                                    <Label Grid.Column="1" Grid.Row="2"  Text="{Binding TaskName}"/>
                                    <Label Grid.Column="2" Grid.Row="1" Text="Статус:" 
                                           TextColor="{Binding IsCompleted,Converter={StaticResource BoolToGreen}}"
                                           TextDecorations="{Binding IsOverdue, Converter={StaticResource BoolToStrike}}"/>
                                    <Label Grid.Column="2" Grid.Row="2"  Text="{Binding DisplayStatus}" 
                                           TextColor="{Binding IsCompleted,Converter={StaticResource BoolToGreen}}"
                                           TextDecorations="{Binding IsOverdue, Converter={StaticResource BoolToStrike}}"/>
                                    
                                    <ImageButton
                                        IsVisible="{Binding IsActual, Converter={StaticResource Inverse}}"
                                        Grid.ColumnSpan="4"
                                        Grid.RowSpan="3"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:PurposesViewModel}}, Path=DeleteDeadlineFastCommand}"
                                        CommandParameter="{Binding .}"   />
                                    
                                    <ImageButton
                                        MaximumWidthRequest="30"
                                        IsVisible="{Binding IsActual}"
                                        Grid.Column="3"
                                        Grid.RowSpan="3"
                                        Source="trash.png"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:PurposesViewModel}}, Path=DeleteDeadlineCommand}"
                                        CommandParameter="{Binding .}"   />
                                </Grid>
                            </Border>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </RefreshView>
            <ImageButton 
                Source="pluscircle.png"
                Command="{Binding ShowAddMenuCommand}"
                WidthRequest="40"
                HeightRequest="40"
                HorizontalOptions="Center"
                Margin="0,10" />
            
            
        </StackLayout>

        <ImageButton
            AbsoluteLayout.LayoutBounds="0,0,1,1"
            AbsoluteLayout.LayoutFlags="All"
    
            BackgroundColor="#000000"
            Opacity="{Binding AddMenuOpacity}"
            IsVisible="{Binding IsAddMenuOpen}"
            InputTransparent="False" 
            Command="{Binding HideAddMenuCommand}"/>


        <!-- 3) Плавающее AddMenu фиксированной высоты -->
        <Grid
            AbsoluteLayout.LayoutBounds="0,0.2,1,0.75"
            AbsoluteLayout.LayoutFlags="All"
            IsVisible="{Binding IsAddMenuOpen}"
            TranslationY="{Binding AddMenuTranslationY}">
            <Border
                InputTransparent="False"
                StrokeThickness="0"
                BackgroundColor="White"
                Padding="20"
                StrokeShape="RoundRectangle 50">
                <StackLayout Spacing="0">
                    <Label 
                        Text="Добавить цель"
                        FontFamily="VisionBold"
                        FontSize="25"
                        Margin="10,30,10,0" />
                    <Entry Placeholder="Описание"  Text="{Binding NewDeadlineName}"/>
                    <Label 
                        Text="Занятие:"
                        FontFamily="VisionBold"
                        FontSize="25"
                        Margin="10,30,10,0" />
                    
                    <Picker Title="Выберите занятие" 
                            ItemsSource="{Binding TasksNames}" 
                            SelectedIndex="{Binding SelectedTaskIndex}"/>
                    <Label 
                        Text="Нужное время в часах:"
                        FontFamily="VisionBold"
                        FontSize="25"
                        Margin="10,30,10,0" />
                    <Entry Text="{Binding NewPlannedTime}"/>
                    <Label 
                        Text="Дата окончания:"
                        FontFamily="VisionBold"
                        FontSize="25"
                        Margin="10,30,10,0" />

                    <DatePicker Date="{Binding DeadlineDate}" MinimumDate="{x:Static sys:DateTime.Today}" Format="D"/>
                    
                    <!-- Confirm -->
                    <ImageButton 
                        Margin="0,25,0,0"
                        Source="confirm.png"
                        Command="{Binding ConfirmAddDeadlineCommand}"
                        
                        WidthRequest="60"
                        HeightRequest="60"
                        HorizontalOptions="End"/>
                    
                </StackLayout>
            </Border>
        </Grid>

    </AbsoluteLayout>
</ContentPage>